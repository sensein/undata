        "authorizationUrl": "https://auth.globus.org/v2/oauth2/authorize",
        "tokenUrl": "https://auth.globus.org/v2/oauth2/token"
      }
    },
    {
      "alias": "github",
      "providerId": "github",
      "enabled": false,
      "displayName": "GitHub",
      "config": {
        "clientId": "",
        "clientSecret": ""
      }
    },
    {
      "alias": "incommon",
      "providerId": "saml",
      "enabled": false,
      "displayName": "InCommon (SAML)",
      "config": {
        "entityId": "",
        "singleSignOnServiceUrl": ""
      }
    }
  ],
  "roles": {
    "realm": [
      {"name": "admin"},
      {"name": "curator"},
      {"name": "contributor"},
      {"name": "viewer"}
    ]
  }
