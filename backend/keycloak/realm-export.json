{
  "realm": "undata",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "undata-backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8002/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost:8002", "http://localhost:3000"],
      "defaultClientScopes": ["openid", "profile", "email"]
    }
  ],
  "identityProviders": [
    {
      "alias": "globus",
      "providerId": "oidc",
      "enabled": false,
      "displayName": "Globus (Institutional Login)",
      "config": {
        "clientId": "${GLOBUS_CLIENT_ID}",
        "clientSecret": "${GLOBUS_CLIENT_SECRET}",
        "discoveryUrl": "https://auth.globus.org/.well-known/openid-configuration",
        "authorizationUrl": "https://auth.globus.org/v2/oauth2/authorize",
        "tokenUrl": "https://auth.globus.org/v2/oauth2/token",
        "userInfoUrl": "https://auth.globus.org/v2/oauth2/userinfo",
        "jwksUrl": "https://auth.globus.org/jwk.json",
        "logoutUrl": "https://auth.globus.org/v2/web/logout",
        "defaultScope": "openid profile email",
        "clientAuthMethod": "client_secret_basic",
        "syncMode": "IMPORT",
        "trustEmail": "true"
      }
    },
    {
      "alias": "github",
      "providerId": "github",
      "enabled": false,
      "displayName": "GitHub",
      "config": {
        "clientId": "${GITHUB_CLIENT_ID}",
        "clientSecret": "${GITHUB_CLIENT_SECRET}"
      }
    }
  ],
  "roles": {
    "realm": [
      {"name": "admin"},
      {"name": "curator"},
      {"name": "contributor"},
      {"name": "viewer"}
    ]
  },
  "defaultRoles": ["viewer"]
}
