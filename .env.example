# undata full-stack configuration
# Copy to .env and adjust as needed: cp .env.example .env

# PostgreSQL
POSTGRES_USER=undata
POSTGRES_PASSWORD=undata
POSTGRES_DB=undata
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Keycloak (OIDC IdP)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=undata
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Backend
BACKEND_PORT=8002
SECRET_KEY=dev-secret-change-in-production
ALIAS_SIMILARITY_THRESHOLD=0.88
TOKEN_CACHE_TTL_SECONDS=300
LOG_LEVEL=INFO

# Migration API
MIGRATION_API_PORT=8004

# Meilisearch
MEILI_PORT=7700
MEILI_MASTER_KEY=dev-master-key

# Frontend
FRONTEND_PORT=3000
API_TOKEN=
