@prefix schema: <https://openminds.om-i.org/types/> .
@prefix props: <https://openminds.om-i.org/props/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

schema:File a rdfs:Class ;
    rdfs:label "File" ;
    rdfs:comment "A file stored in a DANDI dandiset." .

schema:File props:IRI xsd:anyURI ;
    rdfs:domain schema:File ;
    rdfs:label "IRI" ;
    rdfs:comment "The IRI of this file." .

schema:File props:name xsd:string ;
    rdfs:domain schema:File ;
    rdfs:label "name" ;
    rdfs:comment "The name of this file." .
