{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnyOfSample",
  "type": "object",
  "properties": {
    "simple_field": {
      "type": "string",
      "description": "A plain string field"
    },
    "union_field": {
      "anyOf": [
        {"type": "string"},
        {"type": "integer"}
      ],
      "description": "A union field using anyOf"
    },
    "nullable_field": {
      "anyOf": [
        {"type": "boolean"},
        {"type": "null"}
      ],
      "description": "A nullable boolean"
    }
  },
  "required": ["simple_field"]
}
